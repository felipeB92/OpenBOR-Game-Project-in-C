anim  death
	loop  0
		delay  15
		offset  25  25
		sound  data/sounds/glass3.wav
	frame	data/chars/objetos/Molotov/molotov00.gif
	frame	data/chars/objetos/Molotov/molotov01.gif
 	frame	data/chars/objetos/Molotov/molotov02.gif
        @cmd killentity getlocalvar("self")
