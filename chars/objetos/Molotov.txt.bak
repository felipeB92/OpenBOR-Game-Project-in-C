name	 Molotov
health   1
nomove 1 1
#type	pshot#npc#pshot
subtype  weapon

type    enemy
cantgrab 1
antigrab 5
nopain 1
speed 10
falldie 1
candamage player

Load Burn01

animationscript		data/scripts/drago.c

anim	idle#follow1#attack1
	loop	0
	delay	5
	offset	25 25
        sound	data/sounds/golpes/Soco.wav
	frame	data/chars/objetos/Molotov/empty.gif
        @cmd spawn01 "Burn01" 0 0 0
	frame	data/chars/objetos/Molotov/empty.gif
	@cmd killentity getlocalvar("self")
	frame	data/chars/objetos/Molotov/empty.gif

anim  pain
	loop  0
		delay  15
		offset  25  25
	sound  data/sounds/glass3.wav
	frame	data/chars/objetos/Molotov/molotov01.gif
	@cmd killentity getlocalvar("self")
	frame	data/chars/objetos/Molotov/molotov01.gif

anim	spawn#idle
	loop	0
	#jumpframe  0  1.9  0.6  0
	landframe  16
	offset	25 25
	delay	3
	bbox  19  11  13  15
